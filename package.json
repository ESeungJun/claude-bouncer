{
  "name": "claude-bouncer",
  "version": "0.3.0",
  "description": "A tiny pixel Claude that lives on your desktop — plays with you and tells you exactly which Claude Code session needs you.",
  "main": "main.js",
  "author": "ESeungjun",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "install-hook": "node scripts/install-hook.js",
    "uninstall-hook": "node scripts/install-hook.js --uninstall",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "test": "node --test test/*.test.js",
    "sprites": "node tools/sprite-sheet.js docs/sprite-sheet.png 8",
    "template": "node tools/sprite-sheet.js --template assets/skin-template.png"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.eseungjun.claude-bouncer",
    "productName": "Claude Bouncer",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "extension/**",
      "renderer/**",
      "scripts/**",
      "assets/**",
      "package.json",
      "!**/*.bat",
      "!**/*.command"
    ],
    "asarUnpack": [
      "scripts/**",
      "extension/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "Claude-Bouncer-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Claude-Bouncer-${version}-win-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ESeungJun",
        "repo": "claude-bouncer",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
